{
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/netplay-handler.ts": {
      "includeFiles": "src/services/netplayRoomStorage.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/netplay/(.*)",
      "destination": "/api/netplay-handler?action=$1"
    },
    {
      "source": "/api/debug",
      "destination": "/api/debug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
