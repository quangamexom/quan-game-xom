{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "dist/server.cjs",
        "src/data/**",
        "public/assets/games-library.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/debug",
      "destination": "/api/debug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
